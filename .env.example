# CineVault production environment configuration
# Copy to .env and fill in your values. NEVER commit .env to version control.
#
# .env is already covered by .gitignore. This template exists so a fresh
# checkout always has a reference of the full env-var surface.

# === REQUIRED ===

# Flask session secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start in production if this is missing or weak.
SECRET_KEY=replace-me-with-a-64-char-random-hex-string

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=cinevault
DB_PASSWORD=                       # Inject from a secrets manager, not from this file
DB_NAME=cinevault


# === OPTIONAL — Reverse proxy ===

# Number of trusted proxy layers in front of the app. The app uses ProxyFix
# to honor X-Forwarded-For / X-Forwarded-Proto from these layers.
#   0 = app is directly exposed (do not trust client XFF)
#   1 = exactly one trusted reverse proxy (Nginx / Caddy / Cloudflare)
# Set to 1 when running behind Nginx. Mis-setting this is a security risk.
# PROXY_FIX_DEPTH=1


# === OPTIONAL — Video library ===

# Comma-separated absolute paths the app is allowed to read. Users can only
# pick from this list as their personal video_path.
# VIDEO_ROOTS=/var/lib/cinevault/videos,/mnt/external-drive/videos

# Default video directory used for the first-run admin user. Should be one
# of the entries in VIDEO_ROOTS, or a subdirectory of one.
# VIDEO_PATH=/var/lib/cinevault/videos

# Override ffmpeg path. Default ./ffmpeg is the bundled binary. In a real
# deployment you usually want the system ffmpeg.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Where generated thumbnails are written. Must match the directory served
# by the /thumbnail/<f> route.
# THUMBNAIL_DIR=/var/lib/cinevault/thumbnails

# Set to 1 to auto-invalidate the LibraryCache when files change on disk.
# Adds ~5s polling overhead. Disable if your video library is on a slow
# or network filesystem (NFS, SMB).
# ENABLE_FS_WATCHER=1
